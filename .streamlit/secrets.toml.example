# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml for local testing,
# or paste these key-value pairs into Streamlit Community Cloud under:
# App Settings -> Secrets

[neo4j]
uri = "neo4j+s://35.200.158.141:7687"
username = "neo4j"
password = "YOUR_NEO4J_PASSWORD"

[llm]
api_key = "YOUR_OPENAI_OR_AZURE_KEY"
# model = "gpt-4o"

# Optional Azure OpenAI block:
# [azure]
# endpoint = "https://<resource>.services.ai.azure.com/.../openai/v1/"
# api_key = "YOUR_AZURE_API_KEY"
# deployment = "gpt-4o"
# api_version = "2025-01-01-preview"
