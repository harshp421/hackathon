# Copy to .env and fill in. load_graph.py, app.py and smoke_test.py read these.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# --- LLM ---  configure ONE of the two blocks below.
# If neither is set, the pipeline falls back to a regex parser + template answer
# so the demo still runs offline.

# Azure OpenAI (endpoint may be a resource URL or an AI Foundry project URL; the
# code normalises it down to '.../openai/v1/'). No api-version needed on that path.
AZURE_OPENAI_ENDPOINT=https://<resource-or-project>.services.ai.azure.com/.../openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Plain OpenAI (used only if the Azure block above is not set)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
